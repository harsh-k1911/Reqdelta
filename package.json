{
  "name": "reqdelta",
  "productName": "ReqDelta",
  "version": "0.1.0",
  "description": "A desktop API testing and JSON response comparison tool.",
  "private": true,
  "type": "commonjs",
  "main": "electron/main.cjs",
  "engines": { "node": "^22.13.0 || >=24.0.0" },
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "vite build",
    "start": "electron .",
    "demo": "node scripts/demo-server.cjs",
    "db:demo": "node scripts/database-demo.cjs",
    "compare:demo": "node scripts/compare-demo.cjs",
    "test": "vitest run",
    "test:desktop": "npm run build && node scripts/smoke.cjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "playwright-core": "1.64.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
